<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_rounded"
    android:padding="16dp"
    android:elevation="12dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="20dp">


    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵 Recommended Song"
        android:textColor="#4A7C59"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Lyric Text -->

    <!-- Buttons -->
    <TextView
        android:id="@+id/popup_lyric_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#CCF1F8E9"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:textColor="#4A7C59"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/popup_listen_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🎧 Listen"
            android:textColor="#4A7C59"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_gradient"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/popup_close_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Close"
            android:textColor="#4A7C59"
            android:textSize="12sp"
            android:background="@drawable/bg_secondary"
            android:elevation="4dp" />

    </LinearLayout>

</LinearLayout>
