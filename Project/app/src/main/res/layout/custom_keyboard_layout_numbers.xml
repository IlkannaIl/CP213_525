<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:background="#0F172A"
    android:paddingBottom="24dp">

    <!-- First Row - Numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_1_1" android:text="1" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 1"/>
        <Button android:id="@+id/btn_1_2" android:text="2" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 2"/>
        <Button android:id="@+id/btn_1_3" android:text="3" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 3"/>
        <Button android:id="@+id/btn_1_4" android:text="4" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 4"/>
        <Button android:id="@+id/btn_1_5" android:text="5" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 5"/>
        <Button android:id="@+id/btn_1_6" android:text="6" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 6"/>
        <Button android:id="@+id/btn_1_7" android:text="7" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 7"/>
        <Button android:id="@+id/btn_1_8" android:text="8" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 8"/>
        <Button android:id="@+id/btn_1_9" android:text="9" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 9"/>
        <Button android:id="@+id/btn_1_10" android:text="0" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key 0"/>
    </LinearLayout>

    <!-- Second Row - Symbols -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_2_1" android:text="@string/label_at" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key @"/>
        <Button android:id="@+id/btn_2_2" android:text="#" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key #"/>
        <Button android:id="@+id/btn_2_3" android:text="฿" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key ฿"/>
        <Button android:id="@+id/btn_2_4" android:text="_" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key _"/>
        <Button android:id="@+id/btn_2_5" android:text="&amp;" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key &amp;"/>
        <Button android:id="@+id/btn_2_6" android:text="-" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key -"/>
        <Button android:id="@+id/btn_2_7" android:text="+" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key +"/>
        <Button android:id="@+id/btn_2_8" android:text="(" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key ("/>
        <Button android:id="@+id/btn_2_9" android:text=")" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key )"/>
        <Button android:id="@+id/btn_2_10" android:text="/" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key /"/>
    </LinearLayout>



    <!-- Fourth Row - Special Keys -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="11">

        <Button android:id="@+id/btn_symbols_number" android:text="=&lt;" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Symbol layout"/>
        <Button android:id="@+id/btn_3_2" android:text="*" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key *"/>
        <Button android:id="@+id/btn_3_3" android:text="&quot;" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key Double Quote"/>
        <Button android:id="@+id/btn_3_4" android:text="'" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key '"/>
        <Button android:id="@+id/btn_3_5" android:text=":" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key :"/>
        <Button android:id="@+id/btn_3_6" android:text=";" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key ;"/>
        <Button android:id="@+id/btn_3_7" android:text="!" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key !"/>
        <Button android:id="@+id/btn_3_8" android:text="@string/label_question" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Key ?"/>

        <Button android:id="@+id/btn_DEL" android:text="⌫" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Delete key"/>
    </LinearLayout>

    <!-- Fifth Row - Thai Switch and Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="11">
        
        <Button android:id="@+id/btn_thai" android:text="กขค" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Thai layout"/>
        <Button android:id="@+id/btn_comma" android:text="," style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Comma"/>
        <Button android:id="@+id/btn_SPACE" android:text="SPACE" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="5" android:contentDescription="Space bar"/>
        <Button android:id="@+id/btn_period" android:text="." style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Period"/>
        <Button android:id="@+id/btn_ENTER" android:text="↵" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Enter key"/>


    </LinearLayout>

</LinearLayout>
