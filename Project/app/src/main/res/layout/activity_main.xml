<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KeyFlow AI"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI-Powered Keyboard"
        android:textSize="18sp"
        android:layout_marginBottom="48dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_enable_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Enable Keyboard Settings"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_primary_gradient" />

    <Button
        android:id="@+id/btn_switch_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Switch to KeyFlow"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_primary_gradient" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instructions:\n1. Click 'Enable Keyboard Settings'\n2. Enable KeyFlow AI keyboard\n3. Click 'Switch to KeyFlow'\n4. Select KeyFlow AI when typing"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

</LinearLayout>
