<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:paddingBottom="24dp">

    <!-- First Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_Q" android:text="ๆ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๆ"/>
        <Button android:id="@+id/btn_W" android:text="ไ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ไ"/>
        <Button android:id="@+id/btn_E" android:text="ำ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ำ"/>
        <Button android:id="@+id/btn_R" android:text="พ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key พ"/>
        <Button android:id="@+id/btn_T" android:text="ะ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ะ"/>
        <Button android:id="@+id/btn_Y" android:text="ั" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ั"/>
        <Button android:id="@+id/btn_U" android:text="ี" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ี"/>
        <Button android:id="@+id/btn_I" android:text="ร" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ร"/>
        <Button android:id="@+id/btn_O" android:text="น" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key น"/>
        <Button android:id="@+id/btn_P" android:text="ย" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ย"/>
    </LinearLayout>

    <!-- Second Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_A" android:text="ม" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ม"/>
        <Button android:id="@+id/btn_S" android:text="ว" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ว"/>
        <Button android:id="@+id/btn_D" android:text="แ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key แ"/>
        <Button android:id="@+id/btn_F" android:text="ท" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ท"/>
        <Button android:id="@+id/btn_G" android:text="ม" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ม"/>
        <Button android:id="@+id/btn_H" android:text="ใ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ใ"/>
        <Button android:id="@+id/btn_J" android:text="ฝ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฝ"/>
        <Button android:id="@+id/btn_K" android:text="ล" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ล"/>
        <Button android:id="@+id/btn_L" android:text="ฃ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฃ"/>
    </LinearLayout>

    <!-- Third Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_Z" android:text="ฅ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฅ"/>
        <Button android:id="@+id/btn_X" android:text="ฤ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฤ"/>
        <Button android:id="@+id/btn_C" android:text="ฆ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฆ"/>
        <Button android:id="@+id/btn_V" android:text="ฏ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฏ"/>
        <Button android:id="@+id/btn_B" android:text="โ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key โ"/>
        <Button android:id="@+id/btn_N" android:text="ฌ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฌ"/>
        <Button android:id="@+id/btn_M" android:text="็" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ็"/>
        <Button android:id="@+id/btn_comma" android:text="๋" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๋"/>
        <Button android:id="@+id/btn_period" android:text="ษ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ษ"/>
    </LinearLayout>

    <!-- Fourth Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_SHIFT" android:text="SHIFT" style="@style/KeyButton" android:layout_weight="2" android:contentDescription="Shift key"/>
        <Button android:id="@+id/btn_123" android:text="123" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Number layout"/>
        <Button android:id="@+id/btn_SPACE" android:text="SPACE" style="@style/KeyButton" android:layout_weight="3" android:contentDescription="Space bar"/>
        <Button android:id="@+id/btn_comma2" android:text="๋" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๋"/>
        <Button android:id="@+id/btn_period2" android:text="ษ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ษ"/>
        <Button android:id="@+id/btn_DEL" android:text="DEL" style="@style/KeyButton" android:layout_weight="2" android:contentDescription="Delete key"/>
    </LinearLayout>

</LinearLayout>
