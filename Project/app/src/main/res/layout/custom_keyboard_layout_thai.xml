<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:background="#0F172A"
    android:paddingBottom="24dp">

    <!-- First Row - 12 Thai Characters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="12">
        
        <Button android:id="@+id/btn_1" android:text="ๆ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๆ"/>
        <Button android:id="@+id/btn_2" android:text="ไ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ไ"/>
        <Button android:id="@+id/btn_3" android:text="ำ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ำ"/>
        <Button android:id="@+id/btn_4" android:text="พ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key พ"/>
        <Button android:id="@+id/btn_5" android:text="ะ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ะ"/>
        <Button android:id="@+id/btn_6" android:text="ั" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ั"/>
        <Button android:id="@+id/btn_7" android:text="ี" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ี"/>
        <Button android:id="@+id/btn_8" android:text="ร" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ร"/>
        <Button android:id="@+id/btn_9" android:text="น" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key น"/>
        <Button android:id="@+id/btn_10" android:text="ย" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ย"/>
        <Button android:id="@+id/btn_11" android:text="บ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key บ"/>
        <Button android:id="@+id/btn_12" android:text="ล" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ล"/>
    </LinearLayout>

    <!-- Second Row - 12 Thai Characters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="12">
        
        <Button android:id="@+id/btn_13" android:text="ม" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ม"/>
        <Button android:id="@+id/btn_14" android:text="ว" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ว"/>
        <Button android:id="@+id/btn_15" android:text="แ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key แ"/>
        <Button android:id="@+id/btn_16" android:text="ท" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ท"/>
        <Button android:id="@+id/btn_17" android:text="ม" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ม"/>
        <Button android:id="@+id/btn_18" android:text="ใ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ใ"/>
        <Button android:id="@+id/btn_19" android:text="ฝ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฝ"/>
        <Button android:id="@+id/btn_20" android:text="ฃ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฃ"/>
        <Button android:id="@+id/btn_21" android:text="ฅ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฅ"/>
        <Button android:id="@+id/btn_22" android:text="ฤ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฤ"/>
        <Button android:id="@+id/btn_23" android:text="ฆ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฆ"/>
        <Button android:id="@+id/btn_24" android:text="ฏ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฏ"/>
    </LinearLayout>

    <!-- Third Row - 12 Thai Characters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="12">
        
        <Button android:id="@+id/btn_25" android:text="โ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key โ"/>
        <Button android:id="@+id/btn_26" android:text="ฌ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฌ"/>
        <Button android:id="@+id/btn_27" android:text="็" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ็"/>
        <Button android:id="@+id/btn_28" android:text="๋" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๋"/>
        <Button android:id="@+id/btn_29" android:text="ษ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ษ"/>
        <Button android:id="@+id/btn_30" android:text="ศ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ศ"/>
        <Button android:id="@+id/btn_31" android:text="ซ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ซ"/>
        <Button android:id="@+id/btn_32" android:text="ฉ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฉ"/>
        <Button android:id="@+id/btn_33" android:text="ฮ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฮ"/>
        <Button android:id="@+id/btn_34" android:text="ฺ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ฺ"/>
        <Button android:id="@+id/btn_35" android:text="์" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ์"/>
        <Button android:id="@+id/btn_36" android:text="ํ" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ํ"/>
    </LinearLayout>

    <!-- Fourth Row - SHIFT + 11 Thai Characters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="12">
        
        <Button android:id="@+id/btn_SHIFT" android:text="▲" style="@style/KeyButton" android:layout_weight="1.5" android:contentDescription="Shift key"/>
        <Button android:id="@+id/btn_37" android:text="๎" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๎"/>
        <Button android:id="@+id/btn_38" android:text="๏" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๏"/>
        <Button android:id="@+id/btn_39" android:text="๐" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๐"/>
        <Button android:id="@+id/btn_40" android:text="๑" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๑"/>
        <Button android:id="@+id/btn_41" android:text="๒" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๒"/>
        <Button android:id="@+id/btn_42" android:text="๓" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๓"/>
        <Button android:id="@+id/btn_43" android:text="๔" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๔"/>
        <Button android:id="@+id/btn_44" android:text="๕" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๕"/>
        <Button android:id="@+id/btn_45" android:text="๖" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key ๖"/>
        <Button android:id="@+id/btn_DEL" android:text="DEL" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1.5" android:contentDescription="Delete key"/>

    </LinearLayout>

    <!-- Fifth Row - Special Keys -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_123" android:text="@string/label_123" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Number layout"/>
        <Button android:id="@+id/btn_comma" android:text="," style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Comma"/>
        <Button android:id="@+id/btn_SPACE" android:text="ไทย" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="4" android:contentDescription="Space bar"/>
        <Button android:id="@+id/btn_period" android:text="." style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="Period"/>
        <Button android:id="@+id/btn_ENTER" android:text="↵" style="@style/KeyButton" android:layout_width="0dp" android:layout_weight="2" android:contentDescription="Enter key"/>
    </LinearLayout>

</LinearLayout>
