<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:paddingBottom="24dp">

    <!-- First Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_Q" android:text="Q" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key Q"/>
        <Button android:id="@+id/btn_W" android:text="W" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key W"/>
        <Button android:id="@+id/btn_E" android:text="E" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key E"/>
        <Button android:id="@+id/btn_R" android:text="R" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key R"/>
        <Button android:id="@+id/btn_T" android:text="T" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key T"/>
        <Button android:id="@+id/btn_Y" android:text="Y" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key Y"/>
        <Button android:id="@+id/btn_U" android:text="U" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key U"/>
        <Button android:id="@+id/btn_I" android:text="I" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key I"/>
        <Button android:id="@+id/btn_O" android:text="O" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key O"/>
        <Button android:id="@+id/btn_P" android:text="P" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key P"/>
    </LinearLayout>

    <!-- Second Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_A" android:text="A" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key A"/>
        <Button android:id="@+id/btn_S" android:text="S" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key S"/>
        <Button android:id="@+id/btn_D" android:text="D" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key D"/>
        <Button android:id="@+id/btn_F" android:text="F" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key F"/>
        <Button android:id="@+id/btn_G" android:text="G" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key G"/>
        <Button android:id="@+id/btn_H" android:text="H" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key H"/>
        <Button android:id="@+id/btn_J" android:text="J" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key J"/>
        <Button android:id="@+id/btn_K" android:text="K" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key K"/>
        <Button android:id="@+id/btn_L" android:text="L" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key L"/>
    </LinearLayout>

    <!-- Third Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_Z" android:text="Z" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key Z"/>
        <Button android:id="@+id/btn_X" android:text="X" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key X"/>
        <Button android:id="@+id/btn_C" android:text="C" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key C"/>
        <Button android:id="@+id/btn_V" android:text="V" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key V"/>
        <Button android:id="@+id/btn_B" android:text="B" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key B"/>
        <Button android:id="@+id/btn_N" android:text="N" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key N"/>
        <Button android:id="@+id/btn_M" android:text="M" style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Key M"/>
        <Button android:id="@+id/btn_comma" android:text="," style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Comma key"/>
        <Button android:id="@+id/btn_period" android:text="." style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Period key"/>
    </LinearLayout>

    <!-- Fourth Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="10">
        
        <Button android:id="@+id/btn_123" android:text="123" style="@style/KeyButton" android:layout_weight="2" android:contentDescription="Number layout"/>
        <Button android:id="@+id/btn_SPACE" android:text="SPACE" style="@style/KeyButton" android:layout_weight="4" android:contentDescription="Space bar"/>
        <Button android:id="@+id/btn_comma2" android:text="," style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Comma key"/>
        <Button android:id="@+id/btn_period2" android:text="." style="@style/KeyButton" android:layout_weight="1" android:contentDescription="Period key"/>
        <Button android:id="@+id/btn_DEL" android:text="DEL" style="@style/KeyButton" android:layout_weight="2" android:contentDescription="Delete key"/>
    </LinearLayout>

</LinearLayout>
