<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:orientation="vertical"
    android:background="#3E2723"> <!-- Deep Brown Keyboard Background -->

    <!-- Smart Draft Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="5dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_draft_bar_rounded">
        
        <EditText
            android:id="@+id/internal_input_field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FAF0E6"
            android:hint="ร่างข้อความที่นี่..."
            android:textColorHint="#CCCCCC"
            android:background="@drawable/bg_input_field_rounded"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="1"
            android:maxLines="5"
            android:scrollbars="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:scrollHorizontally="false" />
            
        <Button
            android:id="@+id/btn_send_to_app"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="SEND"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
            
    </LinearLayout>

    <!-- 1. Top Bar (Toolbar) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/btn_music_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_music_mode_rounded"
            android:padding="6dp">
            <ImageView 
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_alert"
                android:layout_gravity="center_vertical"
                android:contentDescription="Music mode icon" />
            <TextView 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Music Mode"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_refine"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Refine AI"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_refine_rounded" />
    </RelativeLayout>

    <!-- 2. Suggestion Strip (Clipboard Bar) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/sunset_gradient">
        <LinearLayout 
                android:id="@+id/suggestion_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">
            
            <!-- Lyric Runner Text repurposed for clipboard empty state -->
            <TextView
                android:id="@+id/lyric_runner_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="♪ Clipboard empty - copy some text! ♪"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:selectAllOnFocus="false"
                android:clickable="true" />
                
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. Keys Area -->
    <com.example.keyflowai.CustomKeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

</LinearLayout>