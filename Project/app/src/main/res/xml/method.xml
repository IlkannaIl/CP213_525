<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.example.keyflowai.MainActivity"
    android:icon="@mipmap/ic_launcher"
    android:isDefault="@bool/def_ime_selected"
    android:supportsSwitchingToNextInputMethod="true">
    
    <!-- Define the input method subtype -->
    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:label="@string/app_name"
        android:isAsciiCapable="true"
        android:isAuxiliary="false" />
        
    <!-- Additional subtype for Thai support -->
    <subtype
        android:imeSubtypeLocale="th_TH"
        android:imeSubtypeMode="keyboard"
        android:label="KeyFlow Thai"
        android:isAsciiCapable="true"
        android:isAuxiliary="false" />
        
</input-method>
